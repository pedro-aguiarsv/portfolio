# EmailJS — https://www.emailjs.com/
# Crie um serviço de e-mail, um template com as variáveis
# from_name, from_email, message e reply_to, e cole as chaves aqui.
# Copie este arquivo para .env.local

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Endereço público, depois do deploy. Entra no canonical, Open Graph e sitemap.
NEXT_PUBLIC_SITE_URL=https://pedroaguiar-psi.vercel.app
